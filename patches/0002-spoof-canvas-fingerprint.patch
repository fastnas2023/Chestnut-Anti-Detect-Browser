+void ApplyCanvasNoise(ImageData* image_data, const std::string& seed_str) {
+  if (!image_data || seed_str.empty()) return;
+  
+  DOMUint8ClampedArray* data_array = image_data->data();
+  if (!data_array) return;
+  
+  unsigned char* pixels = data_array->Data();
+  size_t length = data_array->length();
+  
+  // Simple hash of the seed to generate a determinist offset
+  size_t hash = 0;
+  for (char c : seed_str) hash = hash * 31 + c;
+  
+  // Tweak the RGB values of a few specific pixels based on the seed
+  if (length > 4 && hash > 0) {
+    size_t target_pixel = (hash % (length / 4)) * 4;
+    pixels[target_pixel] = (pixels[target_pixel] + 1) % 256; // Alter Red channel slightly
+  }
+}
